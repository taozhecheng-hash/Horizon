{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "languages": [
      "zh"
    ]
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.example.com",
    "smtp_port": 465,
    "imap_enabled": false,
    "imap_server": "imap.example.com",
    "imap_port": 993,
    "email_address": "radar@example.com",
    "sender_name": "Investment Radar",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 20,
      "min_score": 100
    },
    "rss": [
      {
        "name": "NVIDIA Blog",
        "url": "https://blogs.nvidia.com/feed/",
        "enabled": true,
        "category": "ai-infra"
      },
      {
        "name": "AMD Newsroom",
        "url": "https://www.amd.com/en/newsroom/rss.xml",
        "enabled": true,
        "category": "compute-chip"
      },
      {
        "name": "SemiEngineering",
        "url": "https://semiengineering.com/feed/",
        "enabled": true,
        "category": "semiconductor"
      },
      {
        "name": "ServeTheHome",
        "url": "https://www.servethehome.com/feed/",
        "enabled": true,
        "category": "datacenter"
      },
      {
        "name": "Data Center Dynamics",
        "url": "https://www.datacenterdynamics.com/en/rss/",
        "enabled": true,
        "category": "datacenter"
      },
      {
        "name": "HPCwire",
        "url": "https://www.hpcwire.com/feed/",
        "enabled": true,
        "category": "ai-infra"
      },
      {
        "name": "Blocks and Files",
        "url": "https://blocksandfiles.com/feed/",
        "enabled": true,
        "category": "storage"
      },
      {
        "name": "StorageReview",
        "url": "https://www.storagereview.com/feed",
        "enabled": true,
        "category": "storage"
      },
      {
        "name": "The Robot Report",
        "url": "https://www.therobotreport.com/feed/",
        "enabled": true,
        "category": "robotics"
      },
      {
        "name": "IEEE Spectrum Robotics",
        "url": "https://spectrum.ieee.org/feeds/topic/robotics.rss",
        "enabled": true,
        "category": "robotics"
      },
      {
        "name": "IEEE Spectrum Artificial Intelligence",
        "url": "https://spectrum.ieee.org/feeds/topic/artificial-intelligence.rss",
        "enabled": true,
        "category": "ai"
      },
      {
        "name": "IEEE Spectrum Semiconductors",
        "url": "https://spectrum.ieee.org/feeds/topic/semiconductors.rss",
        "enabled": true,
        "category": "semiconductor"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 0
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": false,
      "users": [],
      "fetch_limit": 10,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 5,
      "apify_token_env": "APIFY_TOKEN"
    },
    "openbb": {
      "enabled": false,
      "fetch_filings": false,
      "filings_provider": "sec",
      "watchlists": [
        {
          "name": "us-ai-semiconductor-infra",
          "enabled": true,
          "provider": "yfinance",
          "fetch_limit": 20,
          "category": "equities",
          "symbols": [
            "NVDA",
            "AMD",
            "AVGO",
            "TSM",
            "ASML",
            "ARM",
            "MU",
            "SMCI",
            "DELL",
            "VRT",
            "ETN",
            "CEG",
            "MSFT",
            "GOOGL",
            "AMZN",
            "META",
            "ORCL"
          ]
        }
      ]
    },
    "ossinsight": {
      "enabled": false,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript",
        "Rust"
      ],
      "keywords": [
        "ai",
        "agent",
        "robotics",
        "cuda",
        "inference",
        "datacenter",
        "gpu"
      ],
      "min_stars": 20,
      "max_items": 20
    }
  },
  "filtering": {
    "ai_score_threshold": 6.5,
    "time_window_hours": 24,
    "max_items": 20,
    "category_groups": {
      "ai": {
        "name": "AI / Physical AI",
        "limit": 4,
        "categories": [
          "ai",
          "ai-infra",
          "physical-ai",
          "robotics"
        ]
      },
      "semiconductor": {
        "name": "Semiconductor / Compute Chips",
        "limit": 4,
        "categories": [
          "semiconductor",
          "compute-chip",
          "gpu",
          "cpu",
          "asic"
        ]
      },
      "datacenter": {
        "name": "Datacenter / Power / Cooling",
        "limit": 4,
        "categories": [
          "datacenter",
          "liquid-cooling",
          "power-energy",
          "optical-interconnect"
        ]
      },
      "storage": {
        "name": "Storage / Memory",
        "limit": 3,
        "categories": [
          "storage",
          "dram",
          "nand",
          "hbm",
          "enterprise-ssd"
        ]
      },
      "markets": {
        "name": "A/H/US Listed Supply Chain",
        "limit": 5,
        "categories": [
          "equities",
          "a-share",
          "hk-stock",
          "us-stock",
          "supply-chain"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 3
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "text": "#{message_title}\n\n#{summary?limit=3000&split=---}"
    },
    "headers": ""
  }
}
